{
  "manifest_version": 3,
  "name": "LearnForge — AI Flashcard Generator",
  "version": "2.1.0",
  "description": "Generate Anki flashcards + quiz questions from any learning page using Groq AI. Includes full study dashboard and cloud sync.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://tryhackme.com/*",
    "https://*.tryhackme.com/*",
    "https://hackthebox.com/*",
    "https://*.hackthebox.com/*",
    "https://learn.microsoft.com/*",
    "https://developer.mozilla.org/*",
    "https://www.udemy.com/*",
    "https://coursera.org/*",
    "https://*.coursera.org/*",
    "https://leetcode.com/*",
    "https://portswigger.net/*",
    "https://*.portswigger.net/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://learnforge.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
